#
# Values substituted into the Cloud Run service templates in this directory.
# Copy to production.env (gitignored — it matches .env.*), fill in, and see
# README.md for how to render and apply.
#
# Anything left unset renders as an empty string. For the URLs below that is a
# meaningful choice; for everything else it is a silent misconfiguration, so
# the render step in the README fails on unset required variables.
#

# ── GCP project ───────────────────────────────────────────────────────────────
# Must match the values you gave the Terraform in ../infra.
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
GCP_REGION=us-central1

# The container image to run, including its tag. Your build step pushes this;
# the tag is normally the commit SHA.
CONTAINER_IMAGE=us-docker.pkg.dev/your-gcp-project-id/gcr.io/convictional:abc1234

# Cloud Run revision names. REVISION_NAME is the revision being created;
# SERVING_REVISION_NAME is the one traffic points at. Deploying without
# shifting traffic means rendering twice — see README.md.
REVISION_NAME=convictional-abc1234-1
SERVING_REVISION_NAME=convictional-abc1234-1

# ── Hostnames ─────────────────────────────────────────────────────────────────
# The apex domain the app is served from, and the CDN subdomain serving static
# assets. Both come from the Terraform: `domain`, and cdn_subdomain + domain.
APP_DOMAIN=example.com
CDN_DOMAIN=cdn.example.com

# The uploads bucket, matching the app module's storage_bucket_name.
GCS_BUCKET=your-org-convictional-uploads

# ── Email ─────────────────────────────────────────────────────────────────────
# Sender identities and the Mailgun sending domain. Deliberately have no
# defaults in source — a default would make every deployment send as someone
# else's domain — so the app fails at startup if these are missing.
EMAIL_FROM=noreply@example.com
RESEARCH_EMAIL_FROM=research@example.com
MAILGUN_DOMAIN=example.com

# Operator contacts. FEEDBACK_EMAIL appears on the error page and is the VAPID
# subject; the other two receive signup notices. NEW_USER_NOTIFICATION_EMAILS
# is comma-separated.
FEEDBACK_EMAIL=convictional@example.com
SIGNUP_EMAIL=team@example.com
NEW_USER_NOTIFICATION_EMAILS=convictional@example.com

# ── Externally hosted policy pages ────────────────────────────────────────────
# Leave empty if you have published none: /policies/* then 404s and the sign-in
# footer omits the link. Set them to keep those links live.
TERMS_OF_SERVICE_URL=
PRIVACY_POLICY_URL=
SECURITY_POLICY_URL=

# ── Third-party accounts ──────────────────────────────────────────────────────
# API keys live in Secret Manager (see the secretKeyRef entries in the
# templates); only non-secret account identifiers belong here.
OPENAI_ORGANIZATION=
SENTRY_ORG=
SENTRY_PROJECT_ID=

# ── Native app (leave empty if you are not shipping the mobile app) ───────────
# The iOS-type Google OAuth client for the native app's PKCE sign-in. Not
# secret — it ships in the app binary. MUST match `iosClientId` in
# app/mobile/google-oauth.config.json, or Google returns unauthorized_client.
GOOGLE_OAUTH_IOS_CLIENT_ID=

# Apple Developer Team ID and bundle ID. Both are needed to build the AASA
# appID for Universal Links; with either missing, iOS binds no Universal Links.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=

# ── Jobs service ──────────────────────────────────────────────────────────────
# Request timeout for the jobs service, in seconds. Used for both the Cloud Run
# timeout and the app's own job timeout, so they cannot drift apart.
JOB_TIMEOUT_SECONDS=1800
