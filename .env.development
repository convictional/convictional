LOG_LEVEL=debug
SUPERUSER_EMAILS=darren@ellery.ai
JOB_RUNNER=asyncio
EMAIL_DELIVERY=development
ENABLE_FAKE_AUTH=True
FASTAPI_JSON='{ "openapi_url": "/openapi.json" }'
SHOW_DEBUG_EXCEPTIONS=True
ASSET_BUILDING_ENABLED=True
PAGINATION_DEFAULT_PER_PAGE=3
CACHE_STORE=postgres
EMBEDDING_BACKEND=cached_openai
OAUTH_INCLUDE_GRANTED_SCOPES_ON_LOGIN=False
MAILBOX_SYNC_DEBOUNCE_SECONDS=0
PUSH_ENABLED=true
VITE_ROUTER_DEVTOOLS=false
