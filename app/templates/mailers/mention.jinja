{% extends "base.jinja" %}

{% block subject %}
Re: ({{ titleize(mention.workspace.resource_type) }}) {{ mention.workspace.resource.title }}
{% endblock subject %}

{% block body_markdown %}
{{ mention.creator.display_name }} mentioned you on a {{ titleize(mention.workspace.resource_type)|lower }}.

{{ body }}

