{% extends "base.jinja" %}

{% block subject %}
{% if research_question.in_reply_to_subject %}
Re: {{ research_question.in_reply_to_subject|strip_html }}
{% else %}
[Research] {{ (research_question.title or research_question.body[:50])|strip_html }}
{% endif %}
{% endblock subject %}

{% block body_markdown %}

{% if research_question.is_email_reply and research_question.title %}
# [Research] {{ research_question.title|strip_html }}
{% elif research_question.title %}
# [Research] {{ research_question.title|strip_html }}

> {{ research_question.body|strip_html }}
{% else %}
# [Research] {{ research_question.body|strip_html }}
{% endif %}

{{ research_question.response|with_markdown_format_citations(results_by_id) }}

