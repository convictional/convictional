<style>
.gsi-material-button {
  appearance: none;
  background-color: var(--color-base-50);
  border-radius: 10px;
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  color: var(--color-base-800);
  cursor: pointer;
  font-size: 1rem;
  height: 40px;
  letter-spacing: 0.25px;
  max-width: 400px;
  min-width: min-content;
  outline: none;
  overflow: hidden;
  padding: 0 12px;
  position: relative;
  text-align: center;
  transition: transform 0.3s ease-in-out, background-color 0.3s ease-in-out, box-shadow 0.3s ease-in-out;  user-select: none;
  vertical-align: middle;
  white-space: nowrap;
  width: 100%;
}

.gsi-material-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background-color: hsl(0  0% 100% / 1);
  box-shadow:
    inset 0 0 0 1px hsl(33 5% 100% / 1),
    0 0 0 1px hsl(33 5% 32% / 0.22),
    0 8px 16px -2px hsl(33 5% 32% / 0.22);
}

.gsi-material-button:disabled {
  background: rgb(255 255 255 / 0.38);
  cursor: default;
}

.gsi-material-button:disabled .gsi-material-button-contents,
.gsi-material-button:disabled .gsi-material-button-icon {
  opacity: 0.38;
}

.gsi-material-button .gsi-material-button-content-wrapper {
  align-items: center;
  display: flex;
  height: 100%;
  justify-content: space-between;
  width: 100%;
}

.gsi-material-button .gsi-material-button-icon {
  flex-shrink: 0;
  height: 20px;
  margin-right: 12px;
  width: 20px;
}

.gsi-material-button .gsi-material-button-contents {
  flex-grow: 1;
  font-family: 'Roboto', arial, sans-serif;
  font-weight: 500;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.gsi-material-button .gsi-material-button-state {
  border-radius: inherit;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  position: absolute;
  transition: background-color 0.3s ease-in-out;
}

.gsi-material-button:hover:not(:disabled) .gsi-material-button-state {
  background-color: hsl(0  0% 100% / 1);
}

.gsi-material-button:not(:disabled):is(:active, :focus) .gsi-material-button-state {
  background-color: hsl(0  0% 10% / .25);
}
</style>
