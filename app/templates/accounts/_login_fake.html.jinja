<div class="card bg-base-100 rounded-xl overflow-hidden">
    <div class="p-4 flex flex-col gap-4 bg-base-50/50">
        <div>
            <h1 class="font-bold text-base">Fake login</h1>
        </div>
        <div class="flex justify-center">
            <form {{ test_id("fake-login-form") }}
                  action="{{ url_for('login_fake_post') }}"
                  method="post"
                  class="w-full max-w-lg"
                  hx-boost="false">
                {{ csrf_field() }}
                {% if return_to %}<input type="hidden" name="return_to" value="{{ return_to }}">{% endif %}
                <div class="join flex">
                    <input type="email"
                           name="email"
                           placeholder="New or existing email"
                           class="input grow rounded-lg rounded-r-none border-r-0">
                    {% call submit_button(class="btn btn-primary rounded-l-none text-align-left self-stretch h-auto") %}
                        Log In
                    {% endcall %}
                </div>
            </form>
        </div>
        <div class="flex flex-col gap-4 mt-2">
            {% for organization in all_organizations %}
                {% include "accounts/_login_fake_org.html.jinja" %}
            {% endfor %}
        </div>
    </div>
</div>
