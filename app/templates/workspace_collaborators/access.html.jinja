{% extends application_layout %}
{% block title %}
    {{ "Request access" |format_page_title }}
{% endblock title %}
{% block content %}
    {% set props = {
        "workspaceId": workspace.id | string,
        "backUrl": referrer or url_for('mailbox_index') | string,
    } %}
    <div class="p-6 relative">
        <div class="flex flex-wrap justify-center gap-4">
            <div class="flex flex-col items-center gap-4 w-full max-w-xl">
                <div id="react-workspace-access-request" data-props="{{ props | tojson }}"></div>
            </div>
        </div>
    </div>
{% endblock content %}
