OPENAI_ORGANIZATION=org-P2sGK2yXrkNROvfFZoOI88Qp
# Placeholder so the OpenAI client constructs under tests (>=2.43 rejects empty
# credentials at init); embedding responses are replayed from VCR cassettes.
OPENAI_API_KEY=sk-test
JOB_RUNNER=inline
EMAIL_DELIVERY=fake
# Deterministic in-process embeddings by default; tests that assert on semantic
# search/ranking opt back into recorded OpenAI vectors via @pytest.mark.real_embeddings.
EMBEDDING_BACKEND=fake
HAS_CSRF_PROTECTION=false
ENABLE_FAKE_AUTH=true
ENABLE_MCP_FAKE_AUTH=true
CACHE_STORE=null
MAILBOX_SYNC_DEBOUNCE_SECONDS=0
MAILBOX_RETRY_WAIT_SECONDS=0
VITE_BASE_PATH=/static/build
VAPID_PUBLIC_KEY=test-vapid-public-key
VAPID_PRIVATE_KEY=test-vapid-private-key
PUSH_DELIVERY=fake
