{
  "name": "convictional",
  "version": "1.0.0",
  "description": "Front end assets for convictional",
  "main": "index.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "styles": "tailwindcss -i ./app/styles/tailwind.css -o ./app/static/app.css --minify",
    "styles-watch": "tailwindcss -i ./app/styles/tailwind.css -o ./app/static/app.css --minify --watch",
    "assets": "vite build",
    "assets-watch": "vite --debug",
    "lint": "eslint ./app/javascript --ext .js,.ts,.tsx",
    "lint-fix": "eslint ./app/javascript --ext .js,.ts,.tsx --fix",
    "lint-deps": "depcruise --config .dependency-cruiser.cjs app/javascript",
    "format": "prettier --write \"app/javascript/**/*.{js,ts,tsx}\"",
    "format-check": "prettier --check \"app/javascript/**/*.{js,ts,tsx}\"",
    "types": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test-watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/convictional/convictional.git"
